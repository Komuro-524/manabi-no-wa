# ============================================================
#  学びの輪 — 環境変数のひな形
# ------------------------------------------------------------
#  このファイルは「名前だけ」。値は書かない。
#  各自 .env.local を作って、そこに値を入れる（gitには乗らない）。
#  値の受け渡しは Discord の DM で。公開チャンネルには貼らない。
#  Vercel では管理画面 > Settings > Environment Variables に入れる。
# ============================================================

# --- OrcaRouter ---------------------------------------------
# ★ アカウントは1つに寄せて、そこからスコープ付きキーを3本発行する。
#    理由1: Request Logs のレシートが1か所にまとまる（採点②の証拠）
#    理由2: 権限を分けること自体が採点①の打ち手になる
ORCA_BASE_URL=https://api.orcarouter.ai/v1

# A 記録係：通知権限なし・予算小
ORCA_KEY_RECORDER=

# B 幹事：通知あり・予算あり（人に喋れるのはこの子だけ）
ORCA_KEY_ORGANIZER=

# C 自己分析係：vision 用・予算小
ORCA_KEY_MIRROR=

# --- Supabase -----------------------------------------------
# NEXT_PUBLIC_ が付いた変数はブラウザに焼き込まれる = 公開される。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 🚨 これには絶対に NEXT_PUBLIC_ を付けない。
#    RLS を全部素通りする鍵なので、漏れると全データが読み書きされる。
#    サーバー側（API Route / Edge Function）でだけ使うこと。
SUPABASE_SERVICE_ROLE_KEY=

# --- 格上げ候補の条件（空欄なら右の既定値）---------------------
# 会社の規模やアクティブな人数に合わせて変える。本番では管理者が画面から設定する想定。
# 条件: 直近 WINDOW_DAYS 日に「延べ MIN_MENTIONS 回」または「MIN_SPEAKERS 人以上」が語ったら格上げ候補
TAG_PROPOSE_MIN_SPEAKERS=     # 既定 2  （広がり）
TAG_PROPOSE_MIN_MENTIONS=     # 既定 3  （1人の情熱も拾う）
TAG_PROPOSE_WINDOW_DAYS=      # 既定 30 （0 にすると期間で区切らない）
